public class Solution {
    public static int missingNumber(int[] a, int N) {
        int[] hash = new int[N + 1]; 
        
        for (int i = 0; i < N - 1; i++) {
            hash[a[i]] = 1; 
        }
        for (int i = 1; i <= N; i++) { 
            if (hash[i] == 0) {
                return i;
            }
        }
        return -1; 
    }

    public static void main(String[] args) {
        int N = 5;
        int[] a = {1, 2, 4, 5};
        int missing = missingNumber(a, N); 
        System.out.println("Missing number is: " + missing);
    }
}
