import java.util.*;
class Main {
    
    static int[] arrange(int[] arr, int n){
        List<Integer> pos = new ArrayList<>();
        List<Integer> neg = new ArrayList<>();
        for(int i = 0; i < n; i++){
            if(arr[i] > 0){
                pos.add(arr[i]);
            } else{
                neg.add(arr[i]);
            }
        }
        for(int i = 0; i < n/2; i++){
            arr[i*2] = pos.get(i);
            arr[i*2 + 1] = neg.get(i);
        }
        return arr;
    }
    public static void main(String[] args) {
        int[] arr = {1, 2, -4, -5};
        int n = arr.length;
        int[] arr2 = arrange(arr, n);
        System.out.println("array is : ");
        for(int i = 0; i < n; i++){
            System.out.print(arr2[i] + " ");
        }
    }
}
