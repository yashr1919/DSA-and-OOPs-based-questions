import java.util.*;
class Main {
    
    static List<Integer> arrange(int[] arr, int n){
        List<Integer> lead = new ArrayList<>();
        
        for(int i = 0; i < n; i++){
            boolean leader = true;
            for(int j = i + 1; j < n; j++){
                if(arr[j] > arr[i]){
                    leader = false;
                    break;
                }
            }
            if(leader){
            lead.add(arr[i]);
            }
        }
        
        return lead;
    }
    public static void main(String[] args) {
        int[] arr = {4, 7, 1, 0};
        int n = arr.length;
        List<Integer> ans = arrange(arr,n);
        //int[] arr2 = arrange(arr, n);
        System.out.println("leaders are : ");
        for(int x : ans){
            System.out.print(x + " ");
        }
    }
}
