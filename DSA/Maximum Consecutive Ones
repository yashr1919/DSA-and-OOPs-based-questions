Given a binary array nums, return the maximum number of consecutive 1s in the array.
A binary array is an array that contains only 0s and 1s.

Example 1:
Input: nums = [1, 1, 0, 0, 1, 1, 1, 0]
Output: 3

Explanation:
The maximum consecutive 1s are present from index 4 to index 6, amounting to 3 1s

Example 2:
Input: nums = [0, 0, 0, 0, 0, 0, 0, 0]
Output: 0

Explanation:
No 1s are present in nums, thus we return 0

------------------------------------------------------------------

import java.util.* ;
import java.io.*; 
public class Solution {
	public static int consecutiveOnes(int n, int[] arr) {
		int count = 0;
		int maxi = 0;
		for(int i=0;i<n;i++){
			if(arr[i] == 1){
				count ++;
				maxi = Math.max(maxi,count);
			}
			else{
				count = 0;
			}
		}
		return maxi;
	}
	public static void main(String[] args){
		
		int[] arr = {0, 1, 1, 0, 0, 1, 1, 1};
		int n = arr.length;
		int maxc = consecutiveOnes(n,arr);
		System.out.println("maximum consecutive is : " + maxc);
	}
}
